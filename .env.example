PORT=3000

# Storage backend: "file" (default, zero setup) or "postgres" (optional)
STORAGE_DRIVER=file

# Only used when using the file backend. Defaults to ./data if unset.
# DATA_DIR=./data

# Only required when STORAGE_DRIVER=postgres. Works with any standard
# Postgres connection string — Neon, Supabase, Railway, RDS, a local
# instance, etc.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# SSL mode for the postgres backend:
#   (unset)  -> SSL enabled, cert validation relaxed (works with most managed providers out of the box)
#   strict   -> SSL enabled, cert validation enforced
#   off      -> no SSL (local Postgres without SSL configured)
# PGSSL=strict
